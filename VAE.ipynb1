# =========================================================
# Variational Autoencoder (VAE) for Image Anomaly Detection
# =========================================================

import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, random_split, TensorDataset

import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import precision_score, recall_score, f1_score

from torchvision import datasets, transforms

device = "cuda" if torch.cuda.is_available() else "cpu"
print("Using device:", device)

# ------------------------------
# 1) Dataset: MNIST (Normal = digit '0', Anomaly = digit '1')
# ------------------------------

transform = transforms.Compose([
    transforms.ToTensor()
])

mnist = datasets.MNIST(root="./data", download=True, transform=transform)

# Normal data = digit 0
normal_data = torch.stack([mnist[i][0] for i in range(len(mnist)) if mnist[i][1] == 0])
anomaly_data = torch.stack([mnist[i][0] for i in range(len(mnist)) if mnist[i][1] == 1])

# Dataset split
n_train = int(0.8 * len(normal_data))
n_val   = int(0.1 * len(normal_data))
n_test  = len(normal_data) - n_train - n_val

train_ds = TensorDataset(normal_data[:n_train])
val_ds   = TensorDataset(normal_data[n_train:n_train+n_val])
test_normal_ds = TensorDataset(normal_data[n_train+n_val:n_train+n_val+n_test])
test_anomaly_ds = TensorDataset(anomaly_data[:n_test])

batch_size = 128
train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)
val_loader = DataLoader(val_ds, batch_size=batch_size)
test_normal_loader = DataLoader(test_normal_ds, batch_size=batch_size)
test_anomaly_loader = DataLoader(test_anomaly_ds, batch_size=batch_size)

print("Train normal:", len(train_ds))
print("Val normal:", len(val_ds))
print("Test normal:", len(test_normal_ds))
print("Test anomaly:", len(test_anomaly_ds))


# ------------------------------
# 2) VAE Model
# ------------------------------

class Encoder(nn.Module):
    def __init__(self, latent_dim=16):
        super().__init__()
        self.net = nn.Sequential(
            nn.Flatten(),
            nn.Linear(28*28, 256),
            nn.ReLU(),
            nn.Linear(256, 128),
            nn.ReLU(),
        )
        self.mu = nn.Linear(128, latent_dim)
        self.logvar = nn.Linear(128, latent_dim)

    def forward(self, x):
        h = self.net(x)
        return self.mu(h), self.logvar(h)


class Decoder(nn.Module):
    def __init__(self, latent_dim=16):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(latent_dim, 128),
            nn.ReLU(),
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Linear(256, 28*28),
            nn.Sigmoid()
        )

    def forward(self, z):
        x = self.net(z)
        return x.view(-1, 1, 28, 28)


class VAE(nn.Module):
    def __init__(self, latent_dim=16):
        super().__init__()
        self.encoder = Encoder(latent_dim)
        self.decoder = Decoder(latent_dim)

    def reparameterize(self, mu, logvar):
        std = torch.exp(0.5 * logvar)
        eps = torch.randn_like(std)
        return mu + eps * std

    def forward(self, x):
        mu, logvar = self.encoder(x)
        z = self.reparameterize(mu, logvar)
        x_hat = self.decoder(z)
        return x_hat, mu, logvar


vae = VAE(latent_dim=16).to(device)


# ------------------------------
# 3) Loss Function
# ------------------------------

def vae_loss(x, x_hat, mu, logvar, beta=1.0):
    recon = nn.functional.mse_loss(x_hat, x, reduction="sum")
    kl = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp())
    return recon + beta * kl


# ------------------------------
# 4) Train VAE
# ------------------------------

optimizer = optim.Adam(vae.parameters(), lr=1e-3)

epochs = 20
train_losses = []
val_losses = []

for ep in range(epochs):
    vae.train()
    ep_loss = 0
    for (x,) in train_loader:
        x = x.to(device)
        optimizer.zero_grad()
        x_hat, mu, logvar = vae(x)
        loss = vae_loss(x, x_hat, mu, logvar)
        loss.backward()
        optimizer.step()
        ep_loss += loss.item()

    train_losses.append(ep_loss)

    # validation
    vae.eval()
    val_loss = 0
    with torch.no_grad():
        for (x,) in val_loader:
            x = x.to(device)
            x_hat, mu, logvar = vae(x)
            val_loss += vae_loss(x, x_hat, mu, logvar).item()

    val_losses.append(val_loss)

    print(f"Epoch {ep+1}/{epochs} - Train Loss: {ep_loss:.2f} - Val Loss: {val_loss:.2f}")


# ------------------------------
# 5) Anomaly Threshold (Mean + 3*std)
# ------------------------------

def reconstruction_error(x, x_hat):
    return torch.mean((x - x_hat)**2, dim=[1,2,3])


vae.eval()
errors_val = []

with torch.no_grad():
    for (x,) in val_loader:
        x = x.to(device)
        x_hat, _, _ = vae(x)
        err = reconstruction_error(x, x_hat)
        errors_val.extend(err.cpu().numpy())

errors_val = np.array(errors_val)
threshold = errors_val.mean() + 3 * errors_val.std()

print("Threshold =", threshold)


# ------------------------------
# 6) Testing: Normal vs Anomaly
# ------------------------------

def collect_errors(loader):
    errs = []
    with torch.no_grad():
        for (x,) in loader:
            x = x.to(device)
            x_hat, _, _ = vae(x)
            err = reconstruction_error(x, x_hat)
            errs.extend(err.cpu().numpy())
    return np.array(errs)

normal_errors = collect_errors(test_normal_loader)
anomaly_errors = collect_errors(test_anomaly_loader)

y_true = np.array([0]*len(normal_errors) + [1]*len(anomaly_errors))
y_pred = np.array([
    1 if e > threshold else 0
    for e in np.concatenate([normal_errors, anomaly_errors])
])

precision = precision_score(y_true, y_pred)
recall    = recall_score(y_true, y_pred)
f1        = f1_score(y_true, y_pred)

print("\n=== Final Metrics ===")
print("Precision:", precision)
print("Recall:", recall)
print("F1-Score:", f1)


# ------------------------------
# 7) Visualization
# ------------------------------

def show_reconstruction():
    vae.eval()
    x = next(iter(test_normal_loader))[0][:8].to(device)
    x_hat, _, _ = vae(x)

    x = x.cpu().numpy()
    x_hat = x_hat.cpu().numpy()

    plt.figure(figsize=(12, 3))
    for i in range(8):
        plt.subplot(2, 8, i+1)
        plt.imshow(x[i][0], cmap="gray")
        plt.axis("off")

        plt.subplot(2, 8, 8+i+1)
        plt.imshow(x_hat[i][0], cmap="gray")
        plt.axis("off")

    plt.show()


show_reconstruction()
